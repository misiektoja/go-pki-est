# Repository whitespace conventions: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt uses tabs for indentation and an eight-column tab width
[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

# Go module requirements are tab-indented too
[go.mod]
indent_style = tab
indent_size = tab
tab_width = 8

# Make recipes require tabs
[Makefile]
indent_style = tab
indent_size = tab

# The estclient configuration files are JSON indented by four spaces
[*.cfg]
indent_size = 4

# Two trailing spaces are a line break in Markdown, so leave them alone
[*.md]
trim_trailing_whitespace = false

# Verbatim text that must never be reformatted. The OpenSSL verifier file ends its lines with a tab.
[{LICENSE,cmd/estserver/testdata/srpvfile}]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
